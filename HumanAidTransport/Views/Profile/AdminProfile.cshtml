@model Admin

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Профіль адміністратора</title>

    <link rel="stylesheet" href="~/css/profile/admprofile.css" asp-append-version="true" />
    <script src="~/js/profile/admprofile.js" asp-append-version="true"></script>
</head>
<body>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success custom-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="profile-container">
        <div class="profile-sidebar">
            <div class="profile-pic-container">
                <img src="@Model.ProfilePhotoURL" alt="Фото профілю" class="profile-pic" id="profilePic" />
            </div>

            <h2 class="clientname">@Model.Name</h2>
            <p class="role">Адміністратор</p>

            <form id="logoutForm" method="post" asp-controller="AdminProfile" asp-action="LogOut">
                <button type="submit" class="logout-btn">Вийти</button>
            </form>
        </div>

        <div class="profile-content">
            <h2>Користувачі</h2>

            <div class="filters">
                <label>
                    Порушення:
                    <select id="violationsFilter">
                        <option value="all">Всі</option>
                        <option value="lt2">Менше 2</option>
                        <option value="gte2">2 і більше</option>
                    </select>
                </label>

                <label>
                    Статус блокування:
                    <select id="banFilter">
                        <option value="all">Всі</option>
                        <option value="banned">Заблоковані</option>
                        <option value="notbanned">Не заблоковані</option>
                    </select>
                </label>

                <label>
                    Роль:
                    <select id="roleFilter">
                        <option value="all">Всі</option>
                        <option value="carrier">Перевізник</option>
                        <option value="volunteer">Волонтер</option>
                    </select>
                </label>

                <label>
                    Пошук по імені:
                    <input type="text" id="searchName" placeholder="Введіть ім'я" />
                </label>
            </div>

            <div class="users-container">
                @foreach (var carrier in Model.Carriers)
                {
                    <div class="user-card @(carrier.ViolationsCount >= 2 ? "warning" : "")"
                         data-violations="@carrier.ViolationsCount"
                         data-banned="@(carrier.isBaned.ToString().ToLower())"
                         data-role="carrier">
                        <h3>@carrier.Name</h3>
                        <p><strong>Роль:</strong> Перевізник</p>
                        <p><strong>Контакти:</strong> @carrier.Contacts</p>
                        <p><strong>Дані авто:</strong> @carrier.VehicleName @carrier.VehicleModel (@carrier.VehicleNumber)</p>
                        <p><strong>Порушення:</strong> <span class="@(carrier.ViolationsCount > 2 ? "text-warning" : "")">@carrier.ViolationsCount</span></p>
                        <p><strong>Заблокований:</strong> <span>@(carrier.isBaned ? "Так" : "Ні")</span></p>
                        <div class="action-buttons">
                            <button class="btn btn-danger">Заблокувати</button>
                            <button class="btn btn-success">Розблокувати</button>
                        </div>
                    </div>
                }

                @foreach (var volunteer in Model.Volunteers)
                {
                    <div class="user-card @(volunteer.ViolationsCount >= 2 ? "warning" : "")"
                         data-violations="@volunteer.ViolationsCount"
                         data-banned="@(volunteer.isBaned.ToString().ToLower())"
                         data-role="volunteer">
                        <h3>@volunteer.Name</h3>
                        <p><strong>Роль:</strong> Волонтер</p>
                        <p><strong>Контакти:</strong> -</p>
                        <p><strong>Дані авто:</strong> -</p>
                        <p><strong>Порушення:</strong> <span class="@(volunteer.ViolationsCount > 2 ? "text-warning" : "")">@volunteer.ViolationsCount</span></p>
                        <p><strong>Заблокований:</strong> <span>@(volunteer.isBaned ? "Так" : "Ні")</span></p>
                        <div class="action-buttons">
                            <button class="btn btn-danger">Заблокувати</button>
                            <button class="btn btn-success">Розблокувати</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="~/js/profile/adminprofile.js" asp-append-version="true"></script>
</body>
</html>